# ==========================================
# STM32CubeIDE / Eclipse .gitignore
# ==========================================

# 1. Build Artifacts (Compiled code, object files, binaries)
Debug/
Release/
*.o
*.d
*.su
*.elf
*.bin
*.hex
*.map
*.list
*.log

# 2. STM32CubeMX Backups
*.bak

# 3. Eclipse Workspace Folders 
# (These only appear if you initialized the repo in the overall workspace instead of the project folder)
.metadata/
.recommenders/

# 4. OS-Specific Hidden Files (Mac/Windows)
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini